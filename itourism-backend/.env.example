# Copy to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=postgresql://user:password@localhost:5432/itourism
PORT=4000
FRONTEND_URL=http://localhost:5173

JWT_SECRET=replace-with-output-of-openssl-rand--base64-64
JWT_EXPIRES_IN=7d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

COMMISSION_RATE=0.10

